PROJECT_NAME="HEMC"
SECRET_KEY="your_secure_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT="production"

# Database Connection String
# For Localhost Docker: postgresql://hemc_user:hemc_password@localhost:5433/hemc_db
# For Cloud / Supabase: postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://hemc_user:hemc_password@localhost:5433/hemc_db"

# Production Frontend Allowed Origins (Comma-separated)
CORS_ORIGINS="https://your-frontend.vercel.app,http://localhost:3000"

# AI Inference Service
OPENAI_API_KEY="your_ai_api_key_here"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_MODEL_NAME="meta/llama-3.2-11b-vision-instruct"

# Google / Gmail OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GMAIL_REFRESH_TOKEN="your_gmail_refresh_token"
EMAIL_FROM="official.hemc.unn@gmail.com"
